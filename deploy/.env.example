# Copy to deploy/.env on the server. Keep the real file out of Git.
APP_IMAGE=smart-expiry-server:cloud-local
DB_URL=jdbc:postgresql://YOUR_PRIVATE_DB_HOST:5432/smart_expiry?sslmode=verify-full&sslrootcert=/app/certs/root.crt
DB_USERNAME=smart_expiry_app
DB_POOL_SIZE=10
APP_MEMORY_LIMIT=1g
APP_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
# Password is read from deploy/secrets/db_password.txt, not this file.
