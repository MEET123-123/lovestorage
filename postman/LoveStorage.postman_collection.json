{
  "info": {
    "name": "LoveStorage 本地接口联调",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "本地候选版：先注册或登录，自动保存 accessToken，其余请求继承 Bearer。首次注册自动生成测试用户名和密码，可在环境中自行设置。账号数据相互隔离。退出放在最后。"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00A 首次注册并登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('username')) pm.environment.set('username', 'local_' + pm.variables.replaceIn('{{$guid}}').replace(/-/g,'').slice(0,16));",
              "if (!pm.environment.get('password')) pm.environment.set('password', 'Local_' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const d=pm.response.json().data; pm.environment.set('accessToken',d.accessToken); pm.environment.set('userId',d.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "00B 已有账号登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const d=pm.response.json().data; pm.environment.set('accessToken',d.accessToken); pm.environment.set('userId',d.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "00C 当前账号",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "00D 查询登录方式（手机号/华为配置状态）",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/methods",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const methods = pm.response.json().data;",
              "pm.test('华为未配置时明确关闭', () => pm.expect(methods.huaweiEnabled).to.eql(false));",
              "pm.test('手机号模式已说明', () => pm.expect(['LOCAL_DEBUG','UNAVAILABLE']).to.include(methods.phoneMode));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 健康检查",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('服务 UP', () => pm.expect(result.data.status).to.eql('UP'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "02 查询分类（也会访问数据库）",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('系统分类', () => pm.expect(result.data.map(x => x.id)).to.include('food'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "03 创建测试物品并保存 itemId",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('itemId');",
              "pm.collectionVariables.set('clientId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('到期推导', () => pm.expect(result.data.expiryDate).to.eql('2026-11-03'));",
              "pm.test('返回客户端 ID', () => pm.expect(result.data.id).to.eql(pm.collectionVariables.get('clientId')));",
              "pm.collectionVariables.set('itemId', result.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"name\": \"Postman 联调牛奶\",\n  \"categoryId\": \"food\",\n  \"quantity\": 2,\n  \"unit\": \"盒\",\n  \"productionDate\": \"2026-10-03\",\n  \"shelfLifeValue\": 1,\n  \"shelfLifeUnit\": \"MONTH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 查询列表",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('包含刚创建物品', () => pm.expect(result.data.map(x => x.id)).to.include(pm.collectionVariables.get('itemId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "05 查询详情",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('itemId')) { throw new Error('请先执行 03 创建测试物品'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('ID 正确', () => pm.expect(result.data.id).to.eql(pm.collectionVariables.get('itemId')));",
              "pm.test('到期状态字段', () => pm.expect(result.data).to.have.property('expiryStatus'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/items/{{itemId}}"
      }
    },
    {
      "name": "06 修改名称和保质期",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('itemId')) { throw new Error('请先执行 03 创建测试物品'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('日期重算', () => pm.expect(result.data.expiryDate).to.eql('2026-12-03'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/items/{{itemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman 修改后的牛奶\",\n  \"shelfLifeValue\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 标记已用完（PUT 兼容接口）",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('itemId')) { throw new Error('请先执行 03 创建测试物品'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('已用完', () => pm.expect(result.data.lifecycleStatus).to.eql('CONSUMED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/items/{{itemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lifecycleStatus\": \"CONSUMED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 校验错误示例（预期 400）",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务错误码', () => pm.expect(result.code).to.not.eql(0));",
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"缺少到期信息\",\n  \"categoryId\": \"food\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 软删除本次测试物品",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('itemId')) { throw new Error('请先执行 03 创建测试物品'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务成功', () => pm.expect(result.code).to.eql(0));",
              "pm.test('删除成功', () => pm.expect(result.data).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/items/{{itemId}}"
      }
    },
    {
      "name": "10 删除后查询（预期 404）",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('itemId')) { throw new Error('请先执行 03 创建测试物品'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "const result = pm.response.json();",
              "pm.test('统一响应结构', () => { pm.expect(result).to.have.property('code'); pm.expect(result).to.have.property('message'); });",
              "pm.test('业务错误码', () => pm.expect(result.code).to.not.eql(0));",
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/items/{{itemId}}"
      }
    },
    {
      "name": "11 文本识别草稿（不保存库存）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/recognition/text",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"品名：牛奶\\n生产日期：2026年10月3日\\n保质期：30天\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 查询完整备份",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/backup"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13A 保存当前账号个人资料",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/profile",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Postman 测试昵称\",\n  \"avatarKey\": \"leaf\",\n  \"bio\": \"个人资料接口联调\",\n  \"allergies\": [\"花生\"],\n  \"dislikes\": [\"香菜\"],\n  \"preferences\": [\"清淡\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const profile = pm.response.json().data;",
              "pm.test('昵称已保存', () => pm.expect(profile.displayName).to.eql('Postman 测试昵称'));",
              "pm.test('忌口已保存', () => pm.expect(profile.allergies).to.include('花生'));"
            ]
          }
        }
      ]
    },
    {
      "name": "13B 查询当前账号个人资料",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('返回忌口列表', () => pm.expect(pm.response.json().data.allergies).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 今日关注排序",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/attention?limit=10",
        "description": "认证后的同步库存投影；本机 Today 独立使用本地数据和 snooze。优先级不是安全等级。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Attention 返回 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"返回可解释、稳定的规则结果\", () => {",
              "  pm.expect(body.code).to.eql(0); pm.expect(body.data).to.be.an(\"array\");",
              "  pm.expect(body.data.length).to.be.at.most(10);",
              "  body.data.forEach((row, i) => {",
              "    pm.expect(row.ruleVersion).to.eql(\"attention-rule-v1\");",
              "    pm.expect(row.priority).to.be.oneOf([\"HIGH\", \"MEDIUM\", \"LOW\"]);",
              "    pm.expect(row.reasonCodes).to.be.an(\"array\").that.is.not.empty;",
              "    if (i) pm.expect(body.data[i - 1].score).to.be.at.least(row.score);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "15 完整双批次同步",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sync/inventory/{{syncId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"payload\":{{syncPayload}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('syncId',pm.variables.replaceIn('{{$guid}}'));",
              "const doc={item:{name:'Postman 双批次牛奶',categoryId:'food',lifecycleStatus:'ACTIVE'},batches:[1,2].map(n=>({id:pm.variables.replaceIn('{{$guid}}'),quantity:n,unit:'件',expiryDate:'2027-01-01',lifecycleStatus:'ACTIVE'}))};",
              "pm.environment.set('syncPayload',JSON.stringify(JSON.stringify(doc)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('完整同步成功',()=>pm.response.to.have.status(200));",
              "const snapshot=pm.response.json().data;pm.environment.set('syncVersion',snapshot.version);",
              "pm.test('保留两个批次',()=>pm.expect(JSON.parse(snapshot.payload).batches.length).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 查看完整库存",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/sync/inventory"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('完整库存列表成功',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 幂等重试完整同步",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sync/inventory/{{syncId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"payload\":{{syncPayload}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('相同内容重试成功',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 采集本地事件",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/events",
        "body": {
          "mode": "raw",
          "raw": "{\"events\":[{\"eventId\":\"{{eventId}}\",\"eventType\":\"ITEM_UPDATED\",\"eventVersion\":\"1.0\",\"occurredAt\":\"{{eventAt}}\",\"properties\":{\"itemId\":\"{{syncId}}\"}}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('eventId',pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('eventAt',new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('事件已接受',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 事件积压与发布数",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/events/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('请求成功',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 分页导出算法事件",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/events/export?limit=500"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('请求成功',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 退出当前会话",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.environment.unset('accessToken');"
            ]
          }
        }
      ]
    }
  ]
}
