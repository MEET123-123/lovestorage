DB_URL=jdbc:postgresql://localhost:5432/smart_expiry
DB_USERNAME=smart_expiry
DB_PASSWORD=smart_expiry
SERVER_PORT=8080
# Docker host ports (container ports stay 8080 / 5432)
BACKEND_PORT=18080
POSTGRES_PORT=5432
# Official Docker images mirrored in AWS Public ECR; avoids broken Docker Hub mirrors.
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
JAVA_IMAGE=public.ecr.aws/docker/library/eclipse-temurin:21-jre
